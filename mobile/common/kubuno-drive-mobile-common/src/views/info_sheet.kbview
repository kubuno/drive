<?xml version="1.0" encoding="utf-8"?>
<!--
  Drive · File info sheet - converted from sheet/Sheets.kt (FileInfoSheet). A bottom sheet: the file name, then
  InfoLine rows (label 40% / value 60%): size, type, modified, checksum. Drive LIGHT theme.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x"
       Layout="Dock" BackColor="#73202124">
  <Stack Dock="Bottom" BackColor="#FFFFFF" CornerRadius="16" Padding="0, 8, 0, 16">

    <Stack CrossAlign="Center" Padding="0, 0, 0, 2">
      <Panel BackColor="#BDC1C6" CornerRadius="2" Width="40" Height="4"/>
    </Stack>
    <Label Text="Informations" Role="Body" FontWeight="SemiBold" ForeColor="#202124" Padding="16, 4, 16, 8"/>
    <Label Text="Rapport annuel.pdf" Role="Body" FontWeight="SemiBold" ForeColor="#202124" Overflow="Ellipsis" Padding="16, 0, 16, 8"/>

    <Stack Direction="LeftToRight" Gap="12" Padding="16, 8, 16, 8">
      <Label Text="Taille" Role="Meta" ForeColor="#80868B" Width="110"/>
      <Label Stack.Fill="true" Text="2,4 Mo" Role="Body" ForeColor="#202124"/>
    </Stack>
    <Stack Direction="LeftToRight" Gap="12" Padding="16, 8, 16, 8">
      <Label Text="Type" Role="Meta" ForeColor="#80868B" Width="110"/>
      <Label Stack.Fill="true" Text="application/pdf" Role="Body" ForeColor="#202124"/>
    </Stack>
    <Stack Direction="LeftToRight" Gap="12" Padding="16, 8, 16, 8">
      <Label Text="Modifié" Role="Meta" ForeColor="#80868B" Width="110"/>
      <Label Stack.Fill="true" Text="30 juin 2026, 14:22" Role="Body" ForeColor="#202124"/>
    </Stack>
    <Stack Direction="LeftToRight" Gap="12" Padding="16, 8, 16, 8">
      <Label Text="Somme de contrôle" Role="Meta" ForeColor="#80868B" Width="110"/>
      <Label Stack.Fill="true" Text="a1b2c3d4e5f6a7b8…" Role="Body" ForeColor="#202124"/>
    </Stack>

  </Stack>
</Panel>
