<?xml version="1.0" encoding="utf-8"?>
<!--
  Drive · Onboarding · Server — the ServerScreen of OnboardingScreens.kt: enter the Kubuno server address.
  Centered form, one field, a full-width primary action. Drive LIGHT theme, logical px. Screen root is a Panel.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x"
       Layout="Dock" BackColor="#FFFFFF">
  <Stack Dock="Fill" Justify="Center" CrossAlign="Stretch" Gap="0" Padding="24, 32, 24, 32">
    <Label Text="Ajouter un compte" Role="Display" FontWeight="SemiBold" ForeColor="#202124"/>
    <Label Text="Indiquez l'adresse de votre serveur Kubuno." Role="Body" ForeColor="#5F6368" Padding="0, 8, 0, 0"/>
    <Stack CrossAlign="Stretch" Padding="0, 24, 0, 0">
      <TextField Label="Adresse du serveur" Placeholder="https://drive.exemple.com" LeftIcon="Globe"/>
    </Stack>
    <Stack CrossAlign="Stretch" Padding="0, 16, 0, 0">
      <Button Text="Continuer" Variant="Primary" Size="Lg"/>
    </Stack>
  </Stack>
</Panel>
