{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": ["vite/client", "@kubuno/views-compiler/client"],
    "paths": {
      "@ui": ["./node_modules/@kubuno/ui/types/index.d.ts"],
      "@ui/*": ["./node_modules/@kubuno/ui/types/*.d.ts"]
    },
    // Generated `.kbview` declarations (`ViewBase`), written by the views compiler (kbview-tsc, the Vite plugin).
    "rootDirs": [".", ".kubuno/views"]
  },
  "include": ["src", ".kubuno/views"]
}
