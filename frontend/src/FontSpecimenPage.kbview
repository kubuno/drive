<!-- FontSpecimenPage — converted from FontSpecimenPage.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Panel x:Props="FontSpecimenPageProps" Class="max-w-6xl mx-auto pb-16">
  <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center" Class="mb-6">
    <Panel Class="flex-1 min-w-0">
      <!-- TODO(views-migrate): <Tabs> tabs: no .kbview property -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
    </Panel>
    <Button Size="Sm" IconSize="15" Icon="Download" Text="Télécharger" Visible="{Binding show_on_download}" OnClick="button_click"/>
  </Stack>
  <Panel HtmlTag="Header" Class="pb-6">
    <Stack Direction="LeftToRight" Gap="16" CrossAlign="Start" Justify="SpaceBetween">
      <!-- TODO(views-migrate): <h1> with a computed style -->
      <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
      <Button Variant="Secondary"
              Size="Sm"
              IconSize="15"
              Icon="Trash2"
              Text="Supprimer"
              Visible="{Binding show_on_delete}"
              OnClick="button_click2"/>
    </Stack>
    <Panel ForeColor="TextSecondary" Class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
      <Panel HtmlTag="Span" Visible="{Binding show_data_designer}">
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="Conçu par "/>
        <Label HtmlTag="Span"
               Text="{Binding props.data.designer}"
               FontWeight="Medium"
               Overflow="Wrap"
               ForeColor="TextPrimary"
               InheritFontSize="true"/>
      </Panel>
      <!-- TODO(views-migrate): <a target rel>: attribute(s) without a .kbview property -->
      <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}" Visible="{Binding show_link}"/>
    </Panel>
  </Panel>
  <!-- TODO(views-migrate): <SpecimenTab> is no .kbview element (a local or dynamic component) -->
  <ReactHost Component="{Binding SpecimenTab}" Props="{Binding specimen_tab_props}" Visible="{Binding show_tab_specimen}"/>
  <!-- TODO(views-migrate): <AboutTab> is no .kbview element (a local or dynamic component) -->
  <ReactHost Component="{Binding AboutTab}" Props="{Binding about_tab_props}" Visible="{Binding show_tab_about}"/>
  <!-- TODO(views-migrate): <LicenseTab> is no .kbview element (a local or dynamic component) -->
  <ReactHost Component="{Binding LicenseTab}" Props="{Binding license_tab_props}" Visible="{Binding show_tab_license}"/>
  <!-- TODO(views-migrate): <GlyphsTab> is no .kbview element (a local or dynamic component) -->
  <ReactHost Component="{Binding GlyphsTab}" Props="{Binding glyphs_tab_props}" Visible="{Binding show_tab_glyphs}"/>
</Panel>
