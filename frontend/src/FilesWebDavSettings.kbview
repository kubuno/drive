<!-- FilesWebDavSettings — converted from FilesWebDavSettings.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Panel Class="mt-8 border border-border rounded-xl overflow-hidden">
  <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center" BackColor="Surface1" Class="px-5 py-4 border-b border-border">
    <Stack Direction="LeftToRight" Gap="0" CrossAlign="Center" Justify="Center" Class="w-8 h-8 rounded-lg bg-blue-100 flex-shrink-0">
      <Icon Name="HardDrive" Size="16" Class="text-blue-600"/>
    </Stack>
    <Panel>
      <Label Text="{Res webdav.title, Source=drive}" FontWeight="SemiBold" Overflow="Wrap" ForeColor="TextPrimary"/>
      <Label Text="{Res webdav.subtitle, Source=drive}" Role="Meta" Overflow="Wrap" ForeColor="TextTertiary"/>
    </Panel>
  </Stack>
  <Panel Class="px-5 py-4">
    <Label Text="{Res common.loading, Source=drive}" Overflow="Wrap" ForeColor="TextTertiary" Visible="{Binding isLoading}" Class="py-2"/>
    <Label Text="{Res webdav.creds, Source=drive}"
           Role="Meta"
           FontWeight="SemiBold"
           Overflow="Wrap"
           ForeColor="TextTertiary"
           Visible="{Binding show_not_is_loading}"
           Class="uppercase tracking-wider mb-3"/>
    <!-- TODO(views-migrate): <ConnectRow> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding ConnectRow}" Props="{Binding connect_row_props}" Visible="{Binding show_not_is_loading}"/>
    <!-- TODO(views-migrate): <ConnectRow> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding ConnectRow}" Props="{Binding connect_row_props2}" Visible="{Binding show_not_is_loading}"/>
    <!-- TODO(views-migrate): <ConnectRow> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding ConnectRow}" Props="{Binding connect_row_props3}" Visible="{Binding show_not_is_loading}"/>
    <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center" Visible="{Binding show_not_is_loading}" Class="mt-4">
      <!-- TODO(views-migrate): <Button Icon>: an icon with classes -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
      <Label Text="{Res webdav.regen_hint, Source=drive}" Role="Meta" Overflow="Wrap" ForeColor="TextTertiary"/>
    </Stack>
    <Panel Visible="{Binding show_not_is_loading}" Class="mt-6 space-y-3">
      <Label Text="{Res webdav.how, Source=drive}"
             Role="Meta"
             FontWeight="SemiBold"
             Overflow="Wrap"
             ForeColor="TextTertiary"
             Class="uppercase tracking-wider"/>
      <!-- TODO(views-migrate): <Instruction> is no .kbview element (a local or dynamic component) -->
      <ReactHost Component="{Binding Instruction}" Props="{Binding instruction_props}"/>
      <!-- TODO(views-migrate): <Instruction> is no .kbview element (a local or dynamic component) -->
      <ReactHost Component="{Binding Instruction}" Props="{Binding instruction_props2}"/>
      <!-- TODO(views-migrate): <Instruction> is no .kbview element (a local or dynamic component) -->
      <ReactHost Component="{Binding Instruction}" Props="{Binding instruction_props3}"/>
      <!-- TODO(views-migrate): <Instruction> is no .kbview element (a local or dynamic component) -->
      <ReactHost Component="{Binding Instruction}" Props="{Binding instruction_props4}"/>
    </Panel>
  </Panel>
</Panel>
