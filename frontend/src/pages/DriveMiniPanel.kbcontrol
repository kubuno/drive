<!-- DriveMiniPanel — converted from DriveMiniPanel.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl>
  <Panel Class="min-h-0 flex-1 overflow-y-auto px-2 py-2">
    <Stack Direction="LeftToRight" Gap="0" Justify="Center" Visible="{Binding isLoading}" Class="py-6">
      <Spinner/>
    </Stack>
    <Panel Visible="{Binding show_not_is_loading}" Class="space-y-4">
      <!-- TODO(views-migrate): <Section> is no .kbview element (a local or dynamic component) -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
      <!-- TODO(views-migrate): <Section> is no .kbview element (a local or dynamic component) -->
      <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}" Visible="{Binding show_starred}"/>
    </Panel>
  </Panel>
</UserControl>
