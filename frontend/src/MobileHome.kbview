<!-- MobileHome — converted from MobileHome.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Stack Gap="0" Class="flex-1 min-h-0 overflow-hidden bg-white">
  <Stack Direction="LeftToRight" Gap="0" Class="shrink-0 border-b border-border">
    <Repeater ItemKey="key" ItemsSource="{Binding rows_tabs}">
      <Panel AccessibleRole="PushButton" AutoSize="true" Class="{Binding button_class}" OnClick="panel_click">
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding x.label}"/>
        <Panel HtmlTag="Span" BackColor="Primary" Visible="{Binding active}" Class="absolute inset-x-0 bottom-0 h-[3px] rounded-t"/>
      </Panel>
    </Repeater>
  </Stack>
  <!-- TODO(views-migrate): <Suspense> is no .kbview element (react#Suspense) -->
  <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding show_tab_suggestions}"/>
  <Panel Visible="{Binding show_not_tab_suggestions}" Class="flex-1 min-h-0 overflow-y-auto p-3">
    <!-- TODO(views-migrate): <ActivityTab> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding ActivityTab}"/>
  </Panel>
</Stack>
