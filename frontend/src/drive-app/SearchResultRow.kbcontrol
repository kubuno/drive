<!-- SearchResultRow — converted from SearchResultRow.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="SearchResultRowProps">
  <Stack Direction="LeftToRight"
         Gap="16"
         CrossAlign="Start"
         Class="group py-3 px-2 rounded-lg hover:bg-surface-1 transition-colors">
    <Stack Direction="LeftToRight" Gap="0" CrossAlign="Center" Justify="Center" Class="flex-shrink-0 w-10 pt-0.5">
      <!-- TODO(views-migrate): <ThumbImg> is no .kbview element (a local or dynamic component) -->
      <ReactHost Component="{Binding ThumbImg}" Props="{Binding thumb_img_props}"/>
    </Stack>
    <Panel Class="flex-1 min-w-0">
      <Stack Direction="LeftToRight" CrossAlign="Center">
        <Panel AccessibleRole="PushButton"
               AutoSize="true"
               ForeColor="Primary"
               Class="text-[15px] hover:underline truncate text-left"
               OnClick="panel_click">
          <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding props.file.name}"/>
        </Panel>
        <Label HtmlTag="Span"
               Text="{Res search.badge_semantic, Source=drive}"
               Overflow="Wrap"
               ForeColor="Primary"
               BackColor="PrimaryLight"
               Visible="{Binding show_file_match_kind}"
               Class="flex-shrink-0 text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded-full"/>
        <Icon Name="Star" Size="13" Visible="{Binding props.file.is_starred}" Class="flex-shrink-0 fill-yellow-400 text-yellow-400"/>
        <Label HtmlTag="Span"
               Text="{Res nav.trash, Source=drive}"
               Role="Meta"
               Overflow="Wrap"
               ForeColor="Danger"
               BackColor="DangerLight"
               Visible="{Binding props.file.is_trashed}"
               Class="flex-shrink-0 px-2 py-0.5 rounded-full"/>
      </Stack>
      <Panel HtmlTag="P" ForeColor="TextTertiary" Class="text-xs mt-0.5 truncate flex items-center gap-1">
        <Icon Name="Folder" Size="11" Class="flex-shrink-0 opacity-70"/>
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding text}"/>
      </Panel>
      <!-- TODO(views-migrate): <p dangerouslySetInnerHTML>: attribute(s) without a .kbview property -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding show_file_snippet}"/>
      <Label Text="{Binding p_text}" Role="Meta" Overflow="Wrap" ForeColor="TextTertiary" Class="mt-0.5"/>
    </Panel>
    <!-- TODO(views-migrate): <a target rel>: attribute(s) without a .kbview property -->
    <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
  </Stack>
</UserControl>
