<!-- Breadcrumb — converted from Breadcrumb.tsx by @kubuno/views-migrate. -->
<UserControl x:Props="BreadcrumbProps">
  <Panel Class="contents">
    <Label HtmlTag="H1"
           Text="{Binding props.pageTitle}"
           FontWeight="Medium"
           Overflow="Wrap"
           ForeColor="TextPrimary"
           Visible="{Binding show_case_1}"
           Class="text-xl leading-tight"/>
    <Panel HtmlTag="Nav"
           AccessibleName="{Res app.breadcrumb, Source=drive}"
           Visible="{Binding show_main}"
           Class="flex items-center gap-0.5 flex-wrap">
      <Panel AccessibleRole="PushButton"
             AutoSize="true"
             Class="text-xl font-medium text-text-secondary hover:text-primary transition-colors leading-tight"
             OnClick="panel_click">
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Res nav.my_files, Source=drive}"/>
      </Panel>
      <Repeater ItemKey="key" ItemsSource="{Binding rows_ancestors}">
        <Panel HtmlTag="Span" Class="flex items-center gap-0.5">
          <Icon Name="ChevronRight" Size="16" Class="text-text-tertiary flex-shrink-0"/>
          <Panel AccessibleRole="PushButton"
                 AutoSize="true"
                 Class="text-xl font-medium text-text-secondary hover:text-primary transition-colors leading-tight"
                 OnClick="panel_click2">
            <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding anc.name}"/>
          </Panel>
        </Panel>
      </Repeater>
      <Panel HtmlTag="Span" Class="flex items-center gap-0.5">
        <Icon Name="ChevronRight" Size="16" Class="text-text-tertiary flex-shrink-0"/>
        <Label HtmlTag="Span"
               Text="{Binding span_text}"
               FontWeight="Medium"
               Overflow="Wrap"
               ForeColor="TextPrimary"
               Class="text-xl leading-tight"/>
      </Panel>
    </Panel>
  </Panel>
</UserControl>
