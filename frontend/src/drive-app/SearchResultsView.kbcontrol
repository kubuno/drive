<!-- SearchResultsView — converted from SearchResultsView.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="SearchResultsViewProps">
  <Panel>
    <Stack Direction="LeftToRight" Gap="0" CrossAlign="Center" Justify="SpaceBetween" Class="mb-3">
      <Panel>
        <Stack Direction="LeftToRight" CrossAlign="Center">
          <Label HtmlTag="H1" Text="{Binding label}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary" Class="text-xl"/>
          <Label HtmlTag="Span"
                 Text="{Res search.semantic_on, Source=drive}"
                 Overflow="Wrap"
                 ForeColor="Primary"
                 BackColor="PrimaryLight"
                 Visible="{Binding semantic}"
                 Class="text-[10px] uppercase tracking-wide px-2 py-0.5 rounded-full"/>
        </Stack>
        <Label Text="{Binding p_text}" Overflow="Wrap" ForeColor="TextSecondary" Class="mt-0.5"/>
      </Panel>
      <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center">
        <Panel AccessibleRole="PushButton"
               AutoSize="true"
               Class="flex items-center gap-2 text-sm text-text-secondary hover:text-primary transition-colors"
               OnClick="panel_click">
          <Icon Name="Bookmark" Size="16"/>
          <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="Sauvegarder"/>
        </Panel>
        <Panel AccessibleRole="PushButton"
               AutoSize="true"
               Class="flex items-center gap-2 text-sm text-primary hover:text-primary-hover transition-colors"
               OnClick="panel_click2">
          <Icon Name="X" Size="16"/>
          <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Res app.clear_search, Source=drive}"/>
        </Panel>
      </Stack>
    </Stack>
    <Stack Direction="LeftToRight" Gap="4" CrossAlign="Center" Class="border-b border-border mb-4">
      <Repeater ItemKey="key" ItemsSource="{Binding rows_tabs}">
        <Panel AccessibleRole="PushButton" AutoSize="true" Class="{Binding button_class}" OnClick="panel_click3">
          <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding tb.label}"/>
        </Panel>
      </Repeater>
    </Stack>
    <Stack Direction="LeftToRight"
           CrossAlign="Center"
           Justify="Center"
           ForeColor="TextSecondary"
           Visible="{Binding isLoading}"
           Class="text-sm py-16">
      <Icon Name="Loader2" Size="18" Class="animate-spin"/>
      <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Res app.searching, Source=drive}"/>
    </Stack>
    <Stack Gap="12" CrossAlign="Center" Justify="Center" Visible="{Binding visible2}" Class="py-24 text-center">
      <Icon Name="Search" Size="52" Class="text-text-tertiary"/>
      <Label Text="{Res app.no_results, Source=drive}" Overflow="Wrap" ForeColor="TextSecondary"/>
      <Label Text="{Res app.no_results_hint, Source=drive}" Role="Meta" Overflow="Wrap" ForeColor="TextTertiary"/>
    </Stack>
    <Panel Visible="{Binding visible3}" Class="{Binding div_class}">
      <Repeater ItemKey="key" ItemsSource="{Binding rows_results}">
        <!-- TODO(views-migrate): <SearchResultRow> is no .kbview element (./SearchResultRow#default) -->
        <ReactHost Component="{Binding SearchResultRow}" Props="{Binding search_result_row_props}"/>
      </Repeater>
    </Panel>
    <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center" Justify="Center" Visible="{Binding visible4}" Class="mt-6">
      <Panel AccessibleRole="PushButton"
             AutoSize="true"
             Enabled="{Binding enabled_unless_page}"
             ForeColor="TextSecondary"
             Class="flex items-center gap-1 px-3 py-1.5 text-sm rounded-lg border border-border hover:bg-surface-1 disabled:opacity-40 disabled:cursor-not-allowed"
             OnClick="panel_click4">
        <Icon Name="ChevronLeft" Size="15"/>
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding text}"/>
      </Panel>
      <Label HtmlTag="Span"
             Text="{Res app.page_of, Source=drive, Page={Binding page_of_page}, Total={Binding pageCount}}"
             Overflow="Wrap"
             ForeColor="TextSecondary"/>
      <Panel AccessibleRole="PushButton"
             AutoSize="true"
             Enabled="{Binding enabled_unless_page_page_count}"
             ForeColor="TextSecondary"
             Class="flex items-center gap-1 px-3 py-1.5 text-sm rounded-lg border border-border hover:bg-surface-1 disabled:opacity-40 disabled:cursor-not-allowed"
             OnClick="panel_click5">
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding text2}"/>
        <Icon Name="ChevronRight" Size="15"/>
      </Panel>
    </Stack>
  </Panel>
</UserControl>
