<!-- DriveToolbar — converted from DriveToolbar.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Stack x:Props="Props" Direction="LeftToRight" Gap="12" CrossAlign="Start" Class="mb-5">
  <Panel Class="flex-1 min-w-0">
    <!-- TODO(views-migrate): <Breadcrumb> is no .kbview element (./Breadcrumb#default) -->
    <ReactHost Component="{Binding Breadcrumb}" Props="{Binding breadcrumb_props}"/>
  </Panel>
  <Stack Direction="LeftToRight" Gap="6" CrossAlign="Center" Class="shrink-0 pt-0.5">
    <Label HtmlTag="Span"
           Text="{Res storage.selected, Source=drive, Count={Binding props.selectedCount}}"
           Overflow="Wrap"
           ForeColor="TextSecondary"
           Visible="{Binding show_selected_count}"
           Class="mr-1"/>
    <!-- TODO(views-migrate): <Button Icon>: an icon that is not a Lucide icon -->
    <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding show_selected_count}"/>
    <Button Variant="Secondary" Size="Sm" IconSize="14" Icon="Archive" Text="Compresser" Visible="{Binding visible}" OnClick="button_click"/>
    <Button Variant="Danger"
            Size="Sm"
            IconSize="14"
            Icon="Trash2"
            Enabled="{Binding enabled_unless_delete_disabled}"
            Text="{Res common.delete, Source=drive}"
            Visible="{Binding visible}"
            OnClick="button_click2"/>
    <Button Variant="Secondary"
            Size="Sm"
            IconSize="14"
            Icon="RotateCcw"
            Text="{Res ctx.restore, Source=drive}"
            Visible="{Binding visible2}"
            OnClick="button_click3"/>
    <Button Variant="Danger"
            Size="Sm"
            IconSize="14"
            Icon="Trash2"
            Text="{Res common.delete, Source=drive}"
            Visible="{Binding visible2}"
            OnClick="button_click4"/>
    <Panel AccessibleRole="PushButton"
           AutoSize="true"
           ForeColor="TextTertiary"
           ToolTip="{Res app.cancel_selection, Source=drive}"
           Visible="{Binding show_selected_count}"
           Class="p-1.5 rounded-full hover:bg-surface-2 transition-colors"
           OnClick="panel_click">
      <Icon Name="X" Size="16"/>
    </Panel>
    <Panel Visible="{Binding show_selected_count}" Class="w-px h-5 bg-border mx-0.5"/>
    <Button Variant="Danger"
            Size="Sm"
            IconSize="14"
            Icon="Trash2"
            Enabled="{Binding enabled_unless_purge_pending}"
            Text="{Res app.empty_trash, Source=drive}"
            Visible="{Binding show_trashed_selected_count}"
            OnClick="button_click5"/>
    <Button Variant="Secondary"
            Size="Sm"
            IconSize="14"
            Icon="FolderInput"
            Text="{Res app.folder_btn, Source=drive}"
            Visible="{Binding show_trashed_shared_recent}"
            OnClick="button_click6"/>
    <Button Variant="Secondary"
            Size="Sm"
            IconSize="14"
            Icon="Upload"
            Text="{Res common.import, Source=drive}"
            Visible="{Binding show_trashed_shared_recent}"
            OnClick="button_click7"/>
    <Button Variant="Secondary"
            Size="Sm"
            IconSize="14"
            Icon="FolderPlus"
            Text="{Res newfolder.title, Source=drive}"
            Visible="{Binding show_trashed_shared_recent}"
            OnClick="button_click8"/>
  </Stack>
</Stack>
