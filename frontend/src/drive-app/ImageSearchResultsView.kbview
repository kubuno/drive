<!-- ImageSearchResultsView — converted from ImageSearchResultsView.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Panel x:Props="ImageSearchResultsViewProps">
  <Stack Direction="LeftToRight" Gap="0" CrossAlign="Center" Justify="SpaceBetween" Class="mb-5">
    <Panel>
      <Stack Direction="LeftToRight" CrossAlign="Center">
        <Icon Name="Camera" Size="18" Class="text-primary"/>
        <Label HtmlTag="H1"
               Text="{Res search.similar_to, Source=drive, Name={Binding props.state.name}}"
               FontWeight="Medium"
               ForeColor="TextPrimary"
               Class="text-xl"/>
      </Stack>
      <Label Text="{Binding p_text}" Overflow="Wrap" ForeColor="TextSecondary" Class="mt-0.5"/>
    </Panel>
    <Panel AccessibleRole="PushButton"
           AutoSize="true"
           Class="flex items-center gap-2 text-sm text-primary hover:text-primary-hover transition-colors"
           OnClick="panel_click">
      <Icon Name="X" Size="16"/>
      <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding text}"/>
    </Panel>
  </Stack>
  <Stack Direction="LeftToRight"
         CrossAlign="Center"
         Justify="Center"
         ForeColor="TextSecondary"
         Visible="{Binding props.state.loading}"
         Class="text-sm py-16">
    <Icon Name="Loader2" Size="18" Class="animate-spin"/>
    <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Res app.searching, Source=drive}"/>
  </Stack>
  <Stack Gap="12" CrossAlign="Center" Justify="Center" Visible="{Binding visible}" Class="py-24 text-center">
    <Icon Name="Camera" Size="52" Class="text-text-tertiary"/>
    <Label Text="{Res search.no_similar, Source=drive}" Overflow="Wrap" ForeColor="TextSecondary"/>
  </Stack>
  <Panel Visible="{Binding visible2}" Class="divide-y divide-border">
    <Repeater ItemKey="key" ItemsSource="{Binding rows_results}">
      <!-- TODO(views-migrate): <SearchResultRow> is no .kbview element (./SearchResultRow#default) -->
      <ReactHost Component="{Binding SearchResultRow}" Props="{Binding search_result_row_props}"/>
    </Repeater>
  </Panel>
</Panel>
