<!-- DriveContentGrid — converted from DriveContentGrid.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="Props">
  <Panel Class="contents">
    <Stack Direction="LeftToRight"
           CrossAlign="Center"
           Justify="Center"
           ForeColor="TextSecondary"
           Visible="{Binding show_case_1}"
           Class="text-sm py-16">
      <Icon Name="Loader2" Size="18" Class="animate-spin"/>
      <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Res common.loading, Source=drive}"/>
    </Stack>
    <Stack Gap="12" CrossAlign="Center" Justify="Center" Visible="{Binding show_case_2}" Class="py-24 text-center">
      <Icon Name="Info" Size="36" Class="text-danger"/>
      <Label Text="{Res app.module_down_title, Source=drive}" FontWeight="Medium" Overflow="Wrap" ForeColor="Danger"/>
      <Label Text="{Res app.module_down_hint, Source=drive}" Role="Meta" Overflow="Wrap" ForeColor="TextTertiary"/>
    </Stack>
    <!-- TODO(views-migrate): <EmptyState> is no .kbview element (./EmptyState#default) -->
    <ReactHost Component="{Binding EmptyState}" Props="{Binding empty_state_props}" Visible="{Binding show_case_3}"/>
    <Panel Visible="{Binding show_main}" Class="space-y-6">
      <!-- TODO(views-migrate): <TrashStatsBanner> is no .kbview element (../TrashStatsBanner#default) -->
      <ReactHost Component="{Binding TrashStatsBanner}" Visible="{Binding props.trashed}"/>
      <!-- TODO(views-migrate): <SortFilterBar> is no .kbview element (./SortFilterBar#default) -->
      <ReactHost Component="{Binding SortFilterBar}" Props="{Binding sort_filter_bar_props}" Visible="{Binding show_files_trashed_recent}"/>
      <Stack Direction="LeftToRight"
             Gap="0"
             CrossAlign="Center"
             Visible="{Binding show_files_trashed_recent2}"
             Class="pb-3 -mx-6 px-6 border-b border-border">
        <Panel Class="ml-auto">
          <!-- TODO(views-migrate): <ViewMenu> is no .kbview element (@kubuno/drive#ViewMenu) -->
          <ReactHost Component="{Binding ViewMenu}" Props="{Binding view_menu_props}"/>
        </Panel>
      </Stack>
      <Panel HtmlTag="Section" Visible="{Binding show_folders}">
        <Label HtmlTag="H2"
               Text="{Binding h2_text}"
               Role="Meta"
               FontWeight="SemiBold"
               Overflow="Wrap"
               ForeColor="TextTertiary"
               Class="uppercase tracking-wider mb-2"/>
        <!-- TODO(views-migrate): <div> with a computed style -->
        <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
      </Panel>
      <Panel HtmlTag="Section" Visible="{Binding show_filtered_files}">
        <Panel HtmlTag="H2" ForeColor="TextTertiary" Class="text-xs font-semibold uppercase tracking-wider mb-2">
          <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding text}"/>
          <Label HtmlTag="Span"
                 Text="{Binding span_text}"
                 FontWeight="Regular"
                 Overflow="Wrap"
                 ForeColor="TextTertiary"
                 InheritFontSize="true"
                 Visible="{Binding show_view_type_filter_filtered_files}"
                 Class="ml-2 normal-case"/>
        </Panel>
        <!-- TODO(views-migrate): elements held in an expression -->
        <ReactHost Component="{Binding Fragment}" Props="{Binding content_const_spec_view}"/>
      </Panel>
    </Panel>
  </Panel>
</UserControl>
