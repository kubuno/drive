<!-- TagDots — converted from TagDots.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="TagDotsProps">
  <Panel HtmlTag="Span"
         ToolTip="{Binding tooltip}"
         Visible="{Binding show_main}"
         Class="flex items-center gap-0.5 shrink-0">
    <Repeater ItemKey="key" ItemsSource="{Binding rows_items}">
      <!-- TODO(views-migrate): <span> with a computed style -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
    </Repeater>
  </Panel>
</UserControl>
